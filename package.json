{
  "name": "iroha-mcp",
  "version": "0.5.0",
  "description": "iroha — color into language, language into order. MCP server for brand voice tooling: lint copy and generate feedback against locked brand rules.",
  "type": "module",
  "bin": {
    "iroha-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "node --import tsx --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "json5": "^2.2.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist",
    "templates",
    "docs",
    "brand.config.example.json"
  ],
  "keywords": [
    "iroha",
    "mcp",
    "brand",
    "copy",
    "lint",
    "voice",
    "design-systems",
    "model-context-protocol"
  ],
  "license": "MIT"
}
